<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jeonbuk.repair.controller.CustomerIntakeController">

    <top>
        <VBox styleClass="toss-header">
            <!-- 1줄: 데이터 탐색 (pill 검색 + segmented 필터) -->
            <HBox styleClass="toss-toolbar-row" alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="searchField" styleClass="search-pill"
                           promptText="입고번호 · 차량명 · 차량번호 · 전화 검색" HBox.hgrow="ALWAYS"/>
                <Button text="조회" onAction="#onSearch" styleClass="btn-pill-primary"/>
                <Button text="전체" onAction="#onResetSearch" styleClass="btn-ghost"/>
                <fx:define>
                    <ToggleGroup fx:id="filterGroup"/>
                </fx:define>
                <HBox styleClass="segmented-filter" alignment="CENTER">
                    <ToggleButton fx:id="filterActive" text="진행 중" toggleGroup="$filterGroup" selected="true" onAction="#onFilterChanged"/>
                    <ToggleButton fx:id="filterClosed" text="종결"   toggleGroup="$filterGroup" onAction="#onFilterChanged"/>
                    <ToggleButton fx:id="filterAll"    text="전체"   toggleGroup="$filterGroup" onAction="#onFilterChanged"/>
                </HBox>
            </HBox>
            <!-- 2줄: 레코드 작업 (좌: 신규/삭제 · 우: 종결류 + 컬럼 표시) -->
            <HBox styleClass="toss-toolbar-row, toss-toolbar-row-bottom" alignment="CENTER_LEFT" spacing="6">
                <Button text="+ 신규" onAction="#onNew" styleClass="btn-pill-primary"/>
                <Button text="삭제" onAction="#onDelete" styleClass="btn-ghost"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="closeBtn"  text="종결"     onAction="#onCloseIntake"   styleClass="btn-ghost"/>
                <Button fx:id="reopenBtn" text="종결취소" onAction="#onReopenIntake"  styleClass="btn-ghost"/>
                <Button fx:id="columnsBtn" text="컬럼 ▾" onAction="#onColumnsMenu"    styleClass="btn-ghost"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane fx:id="mainSplit" dividerPositions="0.55" orientation="VERTICAL">

            <!-- editable=true 는 CheckBoxTableCell 이 disable 바인딩에서 풀려 동작하기 위함.
                 다른 컬럼들은 edit cell factory 가 없으므로 텍스트 편집 모드로 들어가지 않는다. -->
            <TableView fx:id="intakeTable" editable="true">
                <columns>
                    <TableColumn fx:id="colSelect" text="" prefWidth="34" minWidth="34" maxWidth="34"
                                 sortable="false" resizable="false"/>

                    <TableColumn fx:id="grpIntake" text="입고 정보" styleClass="group-header">
                        <columns>
                            <TableColumn fx:id="colIntakeNo"      text="입고번호" prefWidth="100"/>
                            <TableColumn fx:id="colIntakeDate"    text="입고일"   prefWidth="100"/>
                            <TableColumn fx:id="colVehicleName"   text="차량명"   prefWidth="120"/>
                            <TableColumn fx:id="colVehicleNumber" text="차량번호" prefWidth="120"/>
                            <TableColumn fx:id="colRepairType"    text="보험여부" prefWidth="140"/>
                        </columns>
                    </TableColumn>

                    <TableColumn fx:id="grpRelease" text="출고/자부담" styleClass="group-header">
                        <columns>
                            <TableColumn fx:id="colReleaseDate"   text="출고일자"     prefWidth="100"/>
                            <TableColumn fx:id="colSelfPayAmount" text="자기부담금"   prefWidth="100"/>
                            <TableColumn fx:id="colSelfPayDate"   text="자부담수납일" prefWidth="110"/>
                        </columns>
                    </TableColumn>

                    <TableColumn fx:id="grpTow" text="견인" styleClass="group-header">
                        <columns>
                            <TableColumn fx:id="colTowDriver" text="기사" prefWidth="100"/>
                            <TableColumn fx:id="colTowAmount" text="금액" prefWidth="100"/>
                        </columns>
                    </TableColumn>

                    <TableColumn fx:id="grpRental" text="대차" styleClass="group-header">
                        <columns>
                            <TableColumn fx:id="colRentalVehicle" text="차량" prefWidth="120"/>
                        </columns>
                    </TableColumn>

                    <TableColumn fx:id="grpOwnClaim" text="자차 보험청구" styleClass="group-header">
                        <columns>
                            <TableColumn fx:id="colOwnCompany"        text="보험사" prefWidth="100"/>
                            <TableColumn fx:id="colOwnClaimAmount"    text="청구액" prefWidth="100"/>
                            <TableColumn fx:id="colOwnReceivedAmount" text="실수령" prefWidth="100"/>
                            <TableColumn fx:id="colOwnReceivedDate"   text="입금일" prefWidth="100"/>
                            <TableColumn fx:id="colOwnDifference"     text="차액"   prefWidth="100"/>
                        </columns>
                    </TableColumn>

                    <TableColumn fx:id="grpOpponentClaim" text="대물 보험청구" styleClass="group-header">
                        <columns>
                            <TableColumn fx:id="colOpponentCompany"        text="보험사" prefWidth="100"/>
                            <TableColumn fx:id="colOpponentClaimAmount"    text="청구액" prefWidth="100"/>
                            <TableColumn fx:id="colOpponentReceivedAmount" text="실수령" prefWidth="100"/>
                            <TableColumn fx:id="colOpponentReceivedDate"   text="입금일" prefWidth="100"/>
                            <TableColumn fx:id="colOpponentDifference"     text="차액"   prefWidth="100"/>
                        </columns>
                    </TableColumn>

                    <TableColumn fx:id="colStatus" text="진행상태" prefWidth="90"/>
                </columns>
            </TableView>

            <VBox fx:id="formPane" spacing="6">
                <padding><Insets top="6" right="12" bottom="10" left="12"/></padding>

                <!-- 닫기 X 버튼 — ScrollPane 바깥 상단에 고정해 가로폭이 좁아져도 항상 노출 -->
                <HBox alignment="CENTER_RIGHT">
                    <Button text="✕" onAction="#onCloseForm" styleClass="form-close-button"/>
                </HBox>

                <!-- 본문 — 입고 / 대차 / 자차 / 대물 4섹션 가로 배치 -->
                <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <HBox spacing="14">
                        <padding><Insets top="4" right="2" bottom="4" left="2"/></padding>

                        <!-- 1. 입고 정보 — 4섹션 비율 2:1:1:1 (입고가 2배). 모든 섹션 hgrow=ALWAYS 로 폭에 비례해 함께 확장 -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="480" prefWidth="520">
                            <Label text="1. 입고 정보" styleClass="section-title"/>
                            <GridPane hgap="6" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="80"  prefWidth="80"/>
                                    <ColumnConstraints hgrow="ALWAYS" prefWidth="160"/>
                                    <ColumnConstraints minWidth="80"  prefWidth="80"/>
                                    <ColumnConstraints hgrow="ALWAYS" prefWidth="160"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints/><RowConstraints/><RowConstraints/>
                                    <RowConstraints/><RowConstraints/><RowConstraints/>
                                    <RowConstraints/><RowConstraints/>
                                </rowConstraints>

                                <Label text="입고번호"     GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="intakeNoField" editable="false"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Label text="입고일*"      GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <DatePicker fx:id="intakeDatePicker" maxWidth="Infinity"
                                            GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                                <Label text="차량명*"      GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <TextField fx:id="vehicleNameField"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label text="차량번호*"    GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <TextField fx:id="vehicleNumberField" promptText="예: 12가3456"
                                           GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                <Label text="전화번호"     GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="phoneField" promptText="010-0000-0000"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <Label text="수리구분*"    GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                <ChoiceBox fx:id="repairTypeChoice" maxWidth="Infinity"
                                           GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                                <Label text="사고유형"     GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3">
                                    <CheckBox fx:id="cbSelf"     text="자차"/>
                                    <CheckBox fx:id="cbOpponent" text="대물"/>
                                    <CheckBox fx:id="cbGeneral"  text="일반수리"/>
                                    <CheckBox fx:id="cbFault"    text="과실"/>
                                </HBox>

                                <Label text="출고일"       GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <DatePicker fx:id="releaseDatePicker" maxWidth="Infinity"
                                            GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                <Label text="자기부담금"   GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                                <TextField fx:id="selfPayAmountField"
                                           GridPane.columnIndex="3" GridPane.rowIndex="4"/>

                                <Label text="자부담수납일" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                <DatePicker fx:id="selfPayDatePicker" maxWidth="Infinity"
                                            GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                                <Label text="견인기사"     GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                                <TextField fx:id="towDriverField"
                                           GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                                <Label text="견인금액"     GridPane.columnIndex="2" GridPane.rowIndex="6"/>
                                <TextField fx:id="towAmountField"
                                           GridPane.columnIndex="3" GridPane.rowIndex="6"/>

                                <Label text="메모"         GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                                <TextArea fx:id="memoArea" prefRowCount="2"
                                          GridPane.columnIndex="1" GridPane.rowIndex="7" GridPane.columnSpan="3"/>
                            </GridPane>
                        </VBox>

                        <Separator orientation="VERTICAL"/>

                        <!-- 2. 자차 보험청구 -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="240" prefWidth="260">
                            <HBox spacing="10">
                                <Label text="2. 자차 보험청구" styleClass="section-title"/>
                                <CheckBox fx:id="useOwnClaimCheck" text="자차 청구 입력"/>
                            </HBox>
                            <GridPane fx:id="ownClaimGrid" hgap="6" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="80"  prefWidth="80"/>
                                    <ColumnConstraints hgrow="ALWAYS" prefWidth="140"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints/><RowConstraints/><RowConstraints/>
                                    <RowConstraints/><RowConstraints/>
                                </rowConstraints>

                                <Label text="보험사"       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="ownCompanyCombo" editable="true" maxWidth="Infinity"
                                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="청구일"       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <DatePicker fx:id="ownClaimDatePicker" maxWidth="Infinity"
                                            GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="청구액"       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="ownClaimAmountField"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="실수령액"     GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <TextField fx:id="ownReceivedAmountField"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <Label text="입금일"       GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <DatePicker fx:id="ownReceivedDatePicker" maxWidth="Infinity"
                                            GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            </GridPane>
                            <TextArea fx:id="ownClaimMemoArea" prefRowCount="1" promptText="자차 청구 메모"/>
                        </VBox>

                        <Separator orientation="VERTICAL"/>

                        <!-- 3. 대물 보험청구 -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="240" prefWidth="260">
                            <HBox spacing="10">
                                <Label text="3. 대물 보험청구" styleClass="section-title"/>
                                <CheckBox fx:id="useOpponentClaimCheck" text="상대 청구 입력"/>
                            </HBox>
                            <GridPane fx:id="opponentClaimGrid" hgap="6" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="80"  prefWidth="80"/>
                                    <ColumnConstraints hgrow="ALWAYS" prefWidth="140"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints/><RowConstraints/><RowConstraints/>
                                    <RowConstraints/><RowConstraints/>
                                </rowConstraints>

                                <Label text="보험사"       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="opponentCompanyCombo" editable="true" maxWidth="Infinity"
                                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="청구일"       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <DatePicker fx:id="opponentClaimDatePicker" maxWidth="Infinity"
                                            GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="청구액"       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="opponentClaimAmountField"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="실수령액"     GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <TextField fx:id="opponentReceivedAmountField"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <Label text="입금일"       GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <DatePicker fx:id="opponentReceivedDatePicker" maxWidth="Infinity"
                                            GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            </GridPane>
                            <TextArea fx:id="opponentClaimMemoArea" prefRowCount="1" promptText="대물 청구 메모"/>
                        </VBox>

                        <Separator orientation="VERTICAL"/>

                        <!-- 4. 대차 -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="240" prefWidth="260">
                            <HBox spacing="10">
                                <Label text="4. 대차" styleClass="section-title"/>
                                <CheckBox fx:id="useRentalCheck" text="대차 등록"/>
                            </HBox>
                            <GridPane fx:id="rentalGrid" hgap="6" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="80"  prefWidth="80"/>
                                    <ColumnConstraints hgrow="ALWAYS" prefWidth="140"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints/><RowConstraints/><RowConstraints/>
                                </rowConstraints>

                                <Label text="대차차량*"    GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="rentalVehicleCombo" maxWidth="Infinity"
                                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="시작일*"      GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <DatePicker fx:id="rentalStartPicker" maxWidth="Infinity"
                                            GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="종료일"       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <DatePicker fx:id="rentalEndPicker" maxWidth="Infinity"
                                            GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            </GridPane>
                            <TextArea fx:id="rentalMemoArea" prefRowCount="1" promptText="대차 메모"/>
                            <Label fx:id="rentalNotice" text="" styleClass="hint"/>
                        </VBox>
                    </HBox>
                </ScrollPane>

                <Separator/>

                <HBox spacing="8">
                    <Button text="저장하고 닫기"      onAction="#onSave"        styleClass="primary" prefWidth="140"/>
                    <Button text="저장하고 새로 입력" onAction="#onSaveAndNew"  prefWidth="160"/>
                    <Button text="초기화"             onAction="#onClear"       prefWidth="100"/>
                    <Button text="닫기"               onAction="#onCloseForm"   prefWidth="100"/>
                </HBox>
            </VBox>

        </SplitPane>
    </center>
</BorderPane>
