<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jeonbuk.repair.controller.InsuranceClaimDetailController"
      styleClass="page" spacing="14"
      prefWidth="1080" prefHeight="600">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <!-- 헤더 -->
    <VBox spacing="2">
        <Label fx:id="titleLabel"     styleClass="page-title"   text="보험사 상세"/>
        <Label fx:id="subtitleLabel"  styleClass="hint"         text=""/>
    </VBox>

    <!-- 청구 목록 -->
    <TableView fx:id="claimTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIntakeNo"     text="입고번호"   prefWidth="100"/>
            <TableColumn fx:id="colVehicleName"  text="차량명"     prefWidth="120"/>
            <TableColumn fx:id="colVehicleNo"    text="차량번호"   prefWidth="120"/>
            <TableColumn fx:id="colSide"         text="구분"       prefWidth="60"/>
            <TableColumn fx:id="colClaimDate"    text="청구일"     prefWidth="100"/>
            <TableColumn fx:id="colClaimAmount"  text="청구액"     prefWidth="110"/>
            <TableColumn fx:id="colReceived"     text="수령액"     prefWidth="110"/>
            <TableColumn fx:id="colOutstanding"  text="미수금"     prefWidth="110"/>
            <TableColumn fx:id="colReceivedDate" text="입금일"     prefWidth="110"/>
            <TableColumn fx:id="colMemo"         text="메모"       prefWidth="160"/>
        </columns>
        <placeholder><Label text="해당 조건의 청구가 없습니다."/></placeholder>
    </TableView>

    <!-- 합계 + 액션 -->
    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="detail-footer">
        <Label fx:id="footerSummary" text=""/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="입고번호 클릭 또는 행 더블클릭 → 입/출고관리로 이동" styleClass="hint"/>
        <Button text="닫기" onAction="#onClose" styleClass="primary" prefWidth="100"/>
    </HBox>
</VBox>
