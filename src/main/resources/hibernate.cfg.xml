<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!--
            DB 연결 (data/repair.db).
            실제 URL 은 HibernateUtil.build() 가 DatabaseInitializer.jdbcUrl() 결과로 override 한다.
            여기 값은 fallback. PRAGMA 파라미터는 DatabaseInitializer.URL_OPTIONS 참고.
        -->
        <property name="hibernate.connection.driver_class">org.sqlite.JDBC</property>
        <property name="hibernate.connection.url">jdbc:sqlite:data/repair.db?foreign_keys=on&amp;date_class=TEXT&amp;date_string_format=yyyy-MM-dd HH:mm:ss.SSS&amp;journal_mode=WAL&amp;synchronous=NORMAL&amp;cache_size=-20000&amp;temp_store=MEMORY&amp;busy_timeout=5000</property>
        <property name="hibernate.connection.username"></property>
        <property name="hibernate.connection.password"></property>

        <!-- SQLite Dialect (community-dialects) -->
        <property name="hibernate.dialect">org.hibernate.community.dialect.SQLiteDialect</property>

        <!-- 단일 사용자 / 단일 PC : pool 1 -->
        <property name="hibernate.connection.pool_size">1</property>

        <!-- 스키마는 직접 마이그레이션 SQL로 관리 -->
        <property name="hibernate.hbm2ddl.auto">none</property>

        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>

        <!-- Entity -->
        <mapping class="com.jeonbuk.repair.model.CustomerIntake"/>
        <mapping class="com.jeonbuk.repair.model.InsuranceClaim"/>
        <mapping class="com.jeonbuk.repair.model.RentalHistory"/>
        <mapping class="com.jeonbuk.repair.model.RentalVehicle"/>
        <mapping class="com.jeonbuk.repair.model.InsuranceCompany"/>
    </session-factory>
</hibernate-configuration>
